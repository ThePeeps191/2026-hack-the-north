{
  "name": "huddle",
  "version": "0.1.0",
  "description": "Huddle desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:scripts",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "test:voice": "npm --prefix tools/voice-lab test --if-present",
    "test:demo": "npm --prefix demo/sketch-night test --if-present",
    "verify:openai": "node --experimental-transform-types src/main/runtime/probe.ts",
    "verify:browser": "node --experimental-transform-types src/main/browser/verify.ts",
    "verify:voice": "npm --prefix tools/voice-lab run verify:live --if-present",
    "smoke": "node --experimental-transform-types scripts/live-smoke.ts",
    "ui-check": "node --experimental-transform-types scripts/ui-check.ts",
    "demo-run": "node --experimental-transform-types scripts/demo-run.ts",
    "start": "electron-vite preview",
    "check": "npm run typecheck && npm test",
    "demo:check": "node scripts/demo-preflight.mjs",
    "demo:start": "npm run build && electron . --remote-debugging-port=9222"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^18.0.1",
    "localtunnel": "^2.0.2",
    "monaco-editor": "^0.56.0",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.19.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
