# ElevenLabs is used only to synthesize AI agent voices.
# Microphone audio never leaves this machine.
ELEVENLABS_API_KEY=

# Optional overrides
VOICE_LAB_HOST=127.0.0.1
VOICE_LAB_PORT=8787
CLIENT_ORIGIN=http://127.0.0.1:5173

# Local faster-whisper model. English-only base is the default on this CPU lab.
# Alternatives: tiny.en (faster, weaker on names/code), small.en (slower, more accurate)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Silero VAD ONNX. Downloaded by `npm run setup`.
SILERO_VAD_MODEL=models/silero_vad.onnx
